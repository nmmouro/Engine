/**
 * ============================================================
 * TABLE
 * Painel Frota
 * Arquivo: table.js
 *
 * Responsabilidade:
 *
 * - Renderizar tabela
 * - Renderizar cabeçalho
 * - Renderizar registros
 * - Renderizar ações
 * - Editar registro
 * - Excluir registro
 * - Filtrar registros
 * - Paginar registros
 *
 * Este arquivo NÃO conhece:
 *
 * - PostgreSQL
 * - Supabase
 * - Google Sheets
 *
 * Comunicação com backend:
 *
 *     engine.editar()
 *     engine.excluir()
 *
 * ============================================================
 */


// ============================================================
// CREATE TABLE
// ============================================================

export function createTable(config = {}) {

    // ========================================================
    // CONFIGURAÇÃO
    // ========================================================

    const entity =
        config.entity || "";

    const schema =
        config.schema || null;

    const container =
        config.container || null;

    const state =
        config.state || null;

    const engine =
        config.engine || null;

    const options =
        config.options || {};


    // ========================================================
    // VALIDAR
    // ========================================================

    if (!container) {

        throw new Error(
            `Table ${entity}: container não informado.`
        );

    }


    if (!state) {

        throw new Error(
            `Table ${entity}: state não informado.`
        );

    }


    if (!engine) {

        throw new Error(
            `Table ${entity}: engine não informado.`
        );

    }


    // ========================================================
    // ELEMENTOS
    // ========================================================

    let tableContainer = null;


    // ========================================================
    // API PÚBLICA
    // ========================================================

    const api = {

        entity,

        schema,

        container,

        state,

        engine,

        options,

        iniciar,

        destruir,

        renderizar,

        filtrar,

        pagina,

        editar,

        excluir

    };


    // ========================================================
    // INICIAR
    // ========================================================

    function iniciar() {

        localizarContainer();

        registrarEventos();

        renderizar();

        return api;

    }


    // ========================================================
    // LOCALIZAR CONTAINER
    // ========================================================

    function localizarContainer() {

        tableContainer =
            container.querySelector(
                "[data-engine-table]"
            );


        if (!tableContainer) {

            throw new Error(
                `Table ${entity}: elemento [data-engine-table] não encontrado.`
            );

        }

    }


    // ========================================================
    // EVENTOS
    // ========================================================

    function registrarEventos() {

        if (!tableContainer) {
            return;
        }


        tableContainer.addEventListener(
            "click",
            tratarClique
        );


        tableContainer.addEventListener(
            "input",
            tratarInput
        );

    }


    // ========================================================
    // TRATAR CLIQUE
    // ========================================================

    function tratarClique(evento) {

        // ====================================================
        // EDITAR
        // ====================================================

        const botaoEditar =
            evento.target.closest(
                "[data-action='editar']"
            );


        if (botaoEditar) {

            const id =
                obterIdBotao(
                    botaoEditar
                );


            console.log(
                `TABLE ${entity} → CLIQUE EDITAR → ID:`,
                id
            );


            if (!id) {

                console.error(
                    `TABLE ${entity} → EDITAR → botão sem data-id`,
                    botaoEditar
                );

                return;

            }


            editar(id);

            return;

        }


        // ====================================================
        // EXCLUIR
        // ====================================================

        const botaoExcluir =
            evento.target.closest(
                "[data-action='excluir']"
            );


        if (botaoExcluir) {

            const id =
                obterIdBotao(
                    botaoExcluir
                );


            console.log(
                `TABLE ${entity} → CLIQUE EXCLUIR → ID:`,
                id
            );


            if (!id) {

                console.error(
                    `TABLE ${entity} → EXCLUIR → botão sem data-id`,
                    botaoExcluir
                );

                return;

            }


            excluir(id);

            return;

        }


        // ====================================================
        // ACTION PERSONALIZADA
        // ====================================================

        const botaoAction =
            evento.target.closest(
                "[data-engine-action]"
            );


        if (botaoAction) {

            const nome =
                botaoAction.getAttribute(
                    "data-engine-action"
                );


            const id =
                obterIdBotao(
                    botaoAction
                );


            if (!nome) {
                return;
            }


            const registro =
                localizarRegistro(
                    id
                );


            if (!registro) {

                console.warn(
                    `TABLE ${entity}: registro da action "${nome}" não encontrado.`
                );

                return;

            }


            engine.action(
                nome,
                registro
            );

        }


        // ====================================================
        // PAGINAÇÃO
        // ====================================================

        const botaoPagina =
            evento.target.closest(
                "[data-page]"
            );


        if (botaoPagina) {

            const paginaNumero =
                Number(
                    botaoPagina.getAttribute(
                        "data-page"
                    )
                );


            pagina(
                paginaNumero
            );

        }

    }


    // ========================================================
    // TRATAR INPUT
    // ========================================================

    function tratarInput(evento) {

        const campo =
            evento.target.closest(
                "[data-table-filtro]"
            );


        if (!campo) {
            return;
        }


        filtrar(
            campo.value
        );

    }


    // ========================================================
    // RENDERIZAR
    // ========================================================

    function renderizar() {

        if (!tableContainer) {

            localizarContainer();

        }


        const registros =
            obterRegistrosFiltrados();


        const paginaAtual =
            obterPaginaAtual(
                registros
            );


        const colunas =
            obterColunas();


        const totalPaginas =
            Math.max(
                1,
                Math.ceil(
                    registros.length /
                    state.paginaTamanho
                )
            );


        // ====================================================
        // CABEÇALHO DA TABELA
        // ====================================================

        let html = `

            <div class="engine-table-toolbar">

                <div class="engine-table-search">

                    <input
                        type="search"
                        placeholder="Pesquisar..."
                        data-table-filtro
                        value="${escaparAtributo(
                            state.filtro
                        )}"
                    >

                </div>

            </div>

        `;


        // ====================================================
        // SEM REGISTROS
        // ====================================================

        if (!paginaAtual.length) {

            html += `

                <div class="engine-empty">

                    Nenhum registro encontrado.

                </div>

            `;


            tableContainer.innerHTML =
                html;


            return;

        }


        // ====================================================
        // TABELA
        // ====================================================

        html += `

            <table class="engine-table">

                <thead>

                    <tr>

        `;


        colunas.forEach(
            coluna => {

                html += `

                    <th>
                        ${escaparHTML(
                            obterTituloColuna(
                                coluna
                            )
                        )}
                    </th>

                `;

            }
        );


        // ====================================================
        // AÇÕES
        // ====================================================

        if (
            permitirAcoes()
        ) {

            html += `

                <th class="engine-actions-header">
                    Ações
                </th>

            `;

        }


        html += `

                    </tr>

                </thead>

                <tbody>

        `;


        // ====================================================
        // LINHAS
        // ====================================================

        paginaAtual.forEach(
            registro => {

                /*
                 * =================================================
                 * IMPORTANTE
                 *
                 * O Supabase retorna:
                 *
                 *     registro.id
                 *
                 * Exemplo:
                 *
                 *     VEI000002
                 *
                 * Nunca usamos uma variável "id"
                 * que não tenha sido criada.
                 * =================================================
                 */

                const id =
                    obterIdRegistro(
                        registro
                    );


                html += `

                    <tr
                        data-row-id="${escaparAtributo(
                            id
                        )}"
                    >

                `;


                // =================================================
                // CÉLULAS
                // =================================================

                colunas.forEach(
                    coluna => {

                        const nome =
                            obterNomeColuna(
                                coluna
                            );


                        const valor =
                            registro?.[nome];


                        html += `

                            <td>

                                ${formatarCelula(
                                    valor,
                                    coluna
                                )}

                            </td>

                        `;

                    }
                );


                // =================================================
                // AÇÕES
                // =================================================

                if (
                    permitirAcoes()
                ) {

                    html += `

                        <td class="engine-actions">

                    `;


                    if (
                        options.permitirEditar !== false
                    ) {

                        html += `

                            <button
                                type="button"
                                data-action="editar"
                                data-id="${escaparAtributo(
                                    id
                                )}"
                            >
                                Editar
                            </button>

                        `;

                    }


                    if (
                        options.permitirExcluir !== false
                    ) {

                        html += `

                            <button
                                type="button"
                                data-action="excluir"
                                data-id="${escaparAtributo(
                                    id
                                )}"
                            >
                                Excluir
                            </button>

                        `;

                    }


                    html +=
                        renderizarActions(
                            registro
                        );


                    html += `

                        </td>

                    `;

                }


                html += `

                    </tr>

                `;

            }
        );


        html += `

                </tbody>

            </table>

        `;


        // ====================================================
        // PAGINAÇÃO
        // ====================================================

        html +=
            renderizarPaginacao(
                totalPaginas
            );


        tableContainer.innerHTML =
            html;

    }


    // ========================================================
    // EDITAR
    // ========================================================

    async function editar(
        id
    ) {

        if (!id) {
            return;
        }


        try {

            await engine.editar(
                String(id).trim()
            );

        } catch (erro) {

            console.error(
                `Table ${entity}: erro ao editar`,
                erro
            );

        }

    }


    // ========================================================
    // EXCLUIR
    // ========================================================

    async function excluir(
        id
    ) {

        if (!id) {
            return;
        }


        try {

            const resultado =
                await engine.excluir(
                    String(id).trim()
                );


            if (
                resultado
            ) {

                renderizar();

            }

        } catch (erro) {

            console.error(
                `Table ${entity}: erro ao excluir`,
                erro
            );

        }

    }


    // ========================================================
    // FILTRAR
    // ========================================================

    function filtrar(
        valor
    ) {

        if (
            typeof engine.filtrar ===
            "function"
        ) {

            engine.filtrar(
                valor
            );

            return;

        }


        state.filtro =
            String(
                valor ?? ""
            )
            .trim()
            .toLowerCase();


        state.paginaAtual =
            1;


        renderizar();

    }


    // ========================================================
    // PAGINAÇÃO
    // ========================================================

    function pagina(
        numero
    ) {

        if (
            typeof engine.pagina ===
            "function"
        ) {

            engine.pagina(
                numero
            );

            return;

        }


        state.paginaAtual =
            Math.max(
                1,
                Number(numero) || 1
            );


        renderizar();

    }


    // ========================================================
    // OBTER REGISTROS FILTRADOS
    // ========================================================

    function obterRegistrosFiltrados() {

        if (
            typeof engine.obterRegistrosFiltrados ===
            "function"
        ) {

            return engine.obterRegistrosFiltrados();

        }


        if (!state.filtro) {

            return state.registros;

        }


        return state.registros.filter(
            registro =>

                Object.values(
                    registro || {}
                )
                .some(
                    valor =>

                        String(
                            valor ?? ""
                        )
                        .toLowerCase()
                        .includes(
                            state.filtro
                        )

                )

        );

    }


    // ========================================================
    // OBTER PÁGINA ATUAL
    // ========================================================

    function obterPaginaAtual(
        registros
    ) {

        const tamanho =
            Number(
                state.paginaTamanho
            ) || 10;


        const pagina =
            Math.max(
                1,
                Number(
                    state.paginaAtual
                ) || 1
            );


        const inicio =
            (
                pagina - 1
            ) *
            tamanho;


        return registros.slice(
            inicio,
            inicio + tamanho
        );

    }


    // ========================================================
    // COLUNAS
    // ========================================================

    function obterColunas() {

        if (
            Array.isArray(
                options.colunas
            )
        ) {

            return options.colunas.filter(
                coluna =>
                    obterNomeColuna(
                        coluna
                    ) !== "id"
            );

        }


        if (
            schema &&
            Array.isArray(
                schema.fields
            )
        ) {

            return schema.fields.filter(

                campo =>

                    campo.visible !== false &&

                    campo.hidden !== true &&

                    campo.table !== false &&

                    campo.name !== "id" &&

                    campo.name !== "ID"

            );

        }


        const primeiro =
            state.registros[0];


        if (!primeiro) {
            return [];
        }


        return Object.keys(
            primeiro
        )
        .filter(
            nome =>
                nome !== "id" &&
                nome !== "ID"
        )
        .map(
            nome => ({

                name: nome,

                label: nome

            })
        );

    }


    // ========================================================
    // NOME DA COLUNA
    // ========================================================

    function obterNomeColuna(
        coluna
    ) {

        return (

            coluna?.name ||

            coluna?.campo ||

            coluna

        );

    }


    // ========================================================
    // TÍTULO DA COLUNA
    // ========================================================

    function obterTituloColuna(
        coluna
    ) {

        return (

            coluna?.label ||

            coluna?.titulo ||

            coluna?.name ||

            coluna?.campo ||

            coluna

        );

    }


    // ========================================================
    // OBTER ID
    // ========================================================

    function obterIdRegistro(
        registro
    ) {

        if (!registro) {
            return "";
        }


        /*
         * PostgreSQL / Supabase:
         *
         *     id
         *
         * Compatibilidade com versões antigas:
         *
         *     ID
         */

        return (

            registro.id ??

            registro.ID ??

            registro.Id ??

            registro.id_registro ??

            registro.ID_REGISTRO ??

            ""

        );

    }


    // ========================================================
    // OBTER ID DO BOTÃO
    // ========================================================

    function obterIdBotao(
        botao
    ) {

        if (!botao) {
            return "";
        }


        const id =
            botao.getAttribute(
                "data-id"
            );


        if (
            id === null ||
            id === undefined
        ) {

            return "";

        }


        return String(
            id
        ).trim();

    }


    // ========================================================
    // LOCALIZAR REGISTRO
    // ========================================================

    function localizarRegistro(
        id
    ) {

        if (!id) {
            return null;
        }


        return state.registros.find(

            registro =>

                String(
                    obterIdRegistro(
                        registro
                    )
                ) ===
                String(id)

        ) || null;

    }


    // ========================================================
    // PERMITIR AÇÕES
    // ========================================================

    function permitirAcoes() {

        return (

            options.permitirEditar !== false ||

            options.permitirExcluir !== false ||

            Object.keys(
                options.actions || {}
            ).length > 0

        );

    }


    // ========================================================
    // ACTIONS PERSONALIZADAS
    // ========================================================

    function renderizarActions(
        registro
    ) {

        const actions =
            options.actions || {};


        return Object.keys(
            actions
        )
        .map(
            nome => {

                if (
                    typeof actions[nome] !==
                    "function"
                ) {

                    return "";

                }


                return `

                    <button
                        type="button"
                        data-engine-action="${escaparAtributo(
                            nome
                        )}"
                        data-id="${escaparAtributo(
                            obterIdRegistro(
                                registro
                            )
                        )}"
                    >

                        ${escaparHTML(
                            obterTituloAction(
                                nome
                            )
                        )}

                    </button>

                `;

            }
        )
        .join("");

    }


    // ========================================================
    // TÍTULO ACTION
    // ========================================================

    function obterTituloAction(
        nome
    ) {

        const titulos = {

            abrirChecklist:
                "Checklist",

            abastecer:
                "Abastecer",

            visualizar:
                "Visualizar",

            finalizar:
                "Finalizar"

        };


        return (
            titulos[nome] ||
            nome
        );

    }


    // ========================================================
    // FORMATAR CÉLULA
    // ========================================================

    function formatarCelula(
        valor,
        coluna
    ) {

        if (
            valor === null ||
            valor === undefined ||
            valor === ""
        ) {

            return "";

        }


        const tipo =
            coluna?.type ||
            coluna?.tipo;


        if (
            tipo === "boolean"
        ) {

            return valor
                ? "SIM"
                : "NÃO";

        }


        if (
            tipo === "date"
        ) {

            return escaparHTML(
                formatarData(
                    valor
                )
            );

        }


        return escaparHTML(
            String(
                valor
            )
        );

    }


    // ========================================================
    // FORMATAR DATA
    // ========================================================

    function formatarData(
        valor
    ) {

        if (!valor) {
            return "";
        }


        /*
         * Evita conversões de timezone
         * desnecessárias para datas YYYY-MM-DD.
         */

        const texto =
            String(
                valor
            );


        if (
            /^\d{4}-\d{2}-\d{2}$/.test(
                texto
            )
        ) {

            const partes =
                texto.split("-");


            return `${partes[2]}/${partes[1]}/${partes[0]}`;

        }


        return texto;

    }


    // ========================================================
    // PAGINAÇÃO HTML
    // ========================================================

    function renderizarPaginacao(
        totalPaginas
    ) {

        if (
            totalPaginas <= 1
        ) {

            return "";

        }


        let html = `

            <div class="engine-pagination">

                <button
                    type="button"
                    data-page="${Math.max(
                        1,
                        state.paginaAtual - 1
                    )}"
                    ${state.paginaAtual <= 1
                        ? "disabled"
                        : ""
                    }
                >
                    Anterior
                </button>

        `;


        for (
            let numero = 1;
            numero <= totalPaginas;
            numero++
        ) {

            html += `

                <button
                    type="button"
                    data-page="${numero}"
                    ${numero === state.paginaAtual
                        ? "disabled"
                        : ""
                    }
                >
                    ${numero}
                </button>

            `;

        }


        html += `

                <button
                    type="button"
                    data-page="${Math.min(
                        totalPaginas,
                        state.paginaAtual + 1
                    )}"
                    ${state.paginaAtual >= totalPaginas
                        ? "disabled"
                        : ""
                    }
                >
                    Próxima
                </button>

            </div>

        `;


        return html;

    }


    // ========================================================
    // ESCAPAR HTML
    // ========================================================

    function escaparHTML(
        valor
    ) {

        return String(
            valor ?? ""
        )

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

    }


    // ========================================================
    // ESCAPAR ATRIBUTO
    // ========================================================

    function escaparAtributo(
        valor
    ) {

        return escaparHTML(
            valor
        );

    }


    // ========================================================
    // DESTRUIR
    // ========================================================

    function destruir() {

        if (tableContainer) {

            tableContainer.removeEventListener(
                "click",
                tratarClique
            );


            tableContainer.removeEventListener(
                "input",
                tratarInput
            );

        }


        tableContainer =
            null;

    }


    // ========================================================
    // RETORNAR API
    // ========================================================

    return api;

}
